# Local development only. Generate unique random values before starting.
POSTGRES_USER=pharmacore
POSTGRES_DB=pharmacore
POSTGRES_PASSWORD=replace-with-a-random-password
DJANGO_SECRET_KEY=replace-with-at-least-32-random-characters
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

REQUIRE_PRIVILEGED_MFA=1
# Required outside debug; generate a Fernet key and store it privately.
MFA_ENCRYPTION_KEY=
